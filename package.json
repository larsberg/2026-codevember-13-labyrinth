{
  "name": "codevember-13-labyrinth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1234 --strictPort",
    "test": "node --test",
    "check": "npm test && npm run build",
    "check:release": "node scripts/check-release.js",
    "publish:source": "node scripts/publish-source.js",
    "publish:pages": "node scripts/publish-pages.js",
    "deploy": "npm run check && npm run check:release && npm run publish:source"
  },
  "dependencies": {
    "@strudel/web": "1.3.0",
    "box3d-wasm": "0.2.0",
    "three": "0.185.1",
    "@strudel/core": "1.2.6",
    "manifold-3d": "3.5.4"
  },
  "devDependencies": {
    "vite": "8.1.3"
  }
}
